# jackc0re btop theme
# Ported 1:1 from the Zed theme via nvim-config/lua/jackc0re/palette.lua

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#FFFFFF", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#212124"

# Main text color
theme[main_fg]="#B8B8B8"

# Title color for boxes
theme[title]="#F6C177"

# Higlight color for keyboard shortcuts
theme[hi_fg]="#cd974b"

# Background color of selected items
theme[selected_bg]="#3a4042"

# Foreground color of selected items
theme[selected_fg]="#D3D3DB"

# Color of inactive/disabled text
theme[inactive_fg]="#454343"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#666666"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#73ca50"

# Cpu box outline color
theme[cpu_box]="#B8B8B8"

# Memory/disks box outline color
theme[mem_box]="#B8B8B8"

# Net up/down box outline color
theme[net_box]="#B8B8B8"

# Processes box outline color
theme[proc_box]="#B8B8B8"

# Box divider line and small boxes line color
theme[div_line]="#454343"

# Temperature graph colors (blue -> amber -> red)
theme[temp_start]="#4a88e4"
theme[temp_mid]="#EA9D34"
theme[temp_end]="#e25d56"

# CPU graph colors (green -> yellow -> red)
theme[cpu_start]="#73ca50"
theme[cpu_mid]="#e9bf57"
theme[cpu_end]="#e25d56"

# Mem/Disk free meter (dark -> green)
theme[free_start]="#273229"
theme[free_mid]=""
theme[free_end]="#73ca50"

# Mem/Disk cached meter (dark blue -> info blue)
theme[cached_start]="#1f2b3d"
theme[cached_mid]=""
theme[cached_end]="#71ade7"

# Mem/Disk available meter (yellow -> bright yellow)
theme[available_start]="#e9bf57"
theme[available_mid]=""
theme[available_end]="#f0bf7a"

# Mem/Disk used meter (red -> bright red)
theme[used_start]="#e25d56"
theme[used_mid]=""
theme[used_end]="#f36868"

# Download graph colors (purple ramp)
theme[download_start]="#915caf"
theme[download_mid]="#CC8BC9"
theme[download_end]="#e987e9"

# Upload graph colors (cyan ramp)
theme[upload_start]="#3E8FB0"
theme[upload_mid]="#23acdd"
theme[upload_end]="#4ac9e2"
